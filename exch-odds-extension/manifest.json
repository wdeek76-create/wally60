{
  "manifest_version": 3,
  "name": "Exchange American Odds",
  "version": "3.3",
  "description": "Shows Novig, ProphetX and 4Cx prices as American odds.",
  "content_scripts": [
    {
      "matches": [
        "https://novig.us/*",
        "https://*.novig.us/*",
        "https://novig.com/*",
        "https://*.novig.com/*",
        "https://novig.co/*",
        "https://*.novig.co/*",
        "https://novig.app/*",
        "https://*.novig.app/*",
        "https://prophetx.co/*",
        "https://*.prophetx.co/*",
        "https://4cx.com/*",
        "https://*.4cx.com/*",
        "https://4cx.io/*",
        "https://*.4cx.io/*",
        "https://4cx.co/*",
        "https://*.4cx.co/*",
        "https://4cx.us/*",
        "https://*.4cx.us/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}