{
  "manifest_version": 3,
  "name": "Exchange American Odds",
  "version": "1.9",
  "description": "Shows Novig and ProphetX prices as American odds.",
  "content_scripts": [
    {
      "matches": [
        "https://novig.us/*",
        "https://*.novig.us/*",
        "https://novig.com/*",
        "https://*.novig.com/*",
        "https://novig.co/*",
        "https://*.novig.co/*",
        "https://novig.app/*",
        "https://*.novig.app/*",
        "https://prophetx.co/*",
        "https://*.prophetx.co/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}