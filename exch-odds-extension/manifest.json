{
  "manifest_version": 3,
  "name": "Exchange American Odds",
  "version": "1.0",
  "description": "Shows American odds next to every % / ¢ price on Novig and ProphetX.",
  "content_scripts": [
    {
      "matches": ["https://novig.us/*", "https://*.novig.us/*", "https://prophetx.co/*", "https://*.prophetx.co/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
