{
  "manifest_version": 3,
  "name": "FD Enter to Bet",
  "version": "1.0",
  "description": "Press Enter on FanDuel's bet slip to hit the Place bet button.",
  "content_scripts": [
    {
      "matches": ["https://*.sportsbook.fanduel.com/*", "https://sportsbook.fanduel.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
